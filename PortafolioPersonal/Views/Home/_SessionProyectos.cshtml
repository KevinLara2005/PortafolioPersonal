@model IEnumerable<PortafolioPersonal.Models.ProyectoDTO>

<div class="container py-5">
    <h2 class="mb-4" style="font-weight: 700; font-size: 2rem;">Proyectos Destacados</h2>
    <div class="row g-4">
        @foreach (var proyecto in Model)
        {

            <div class="col-md-4">
                <div class="project-card">
                    <img src="@proyecto.ImagenURL" alt="@proyecto.Titulo">
                    <div class="card-body">
                        <h5 class="card-title">@proyecto.Titulo</h5>
                        <p class="card-text">@proyecto.Descripcion</p>
                        <div>
                            <span class="tech-tag">.NET</span>
                            <span class="tech-tag">MVC</span>
                            <span class="tech-tag">SQL</span>
                        </div>
                        <a href="@proyecto.Link" class="btn btn-outline-custom w-100 mt-3" style="font-size: 0.9rem;">
                            Ver detalles <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>
                </div>
            </div>
        }
    </div>
</div>