@model IEnumerable<PortafolioPersonal.Models.ProyectoDTO>

<div class="text-center mt-5 mb-3">
    <h2>Mis trabajos recientes</h2>
    <p>Aquí puedes ver algunos de mis trabajos más recientes</p>
</div>

<div class="row">
    @foreach (var proyecto in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <img src="@proyecto.ImagenURL" class="card-img-top" alt="@proyecto.Titulo" style="height: 200px; object-fit: cover;" />
                <div class="card-body">
                    <h5 class="card-title">@proyecto.Titulo</h5>
                    <p class="card-text">@proyecto.Descripcion</p>
                    <a href="@proyecto.Link" target="_blank" class="btn btn-primary">Visitar</a>
                </div>
            </div>
        </div>
    }
</div>